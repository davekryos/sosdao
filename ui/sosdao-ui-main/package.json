    "@hookform/resolvers": "2.9.10",
    "@pmmmwh/react-refresh-webpack-plugin": "0.5.3",
    "@svgr/webpack": "5.5.0",
    "@walletconnect/web3-provider": "1.7.7",
    "@web3modal/ethereum": "^2.1.1",
    "@web3modal/react": "^2.1.1",
    "assert": "2.0.0",
    "babel-jest": "27.4.2",
    "babel-loader": "8.2.3",
    "babel-plugin-named-asset-import": "0.3.8",
    "babel-preset-react-app": "10.0.1",
    "bfj": "7.0.2",
    "bootstrap": "4.3.1",
    "browserslist": "4.18.1",
    "camelcase": "6.2.1",
    "case-sensitive-paths-webpack-plugin": "2.4.0",
    "convert-svg-react": "1.0.0-beta.8",
    "crypto-browserify": "3.12.0",
    "css-loader": "6.5.1",
    "css-minimizer-webpack-plugin": "3.2.0",
    "decimal.js": "10.3.1",
    "dotenv": "10.0.0",
    "dotenv-expand": "5.1.0",
    "eslint": "8.3.0",
    "eslint-config-react-app": "7.0.0",
    "eslint-webpack-plugin": "3.1.1",
    "eth-provider": "0.10.0",
    "ethers": "^5.7.2",
    "file-loader": "6.2.0",
    "font-awesome": "4.7.0",
    "fs-extra": "10.0.0",
    "html-webpack-plugin": "5.5.0",
    "https-browserify": "1.0.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "27.4.3",
    "jest-resolve": "27.4.2",
    "jest-watch-typeahead": "1.0.0",
    "leaflet": "1.9.3",
    "mini-css-extract-plugin": "2.4.5",
    "node-sass": "8.0.0",
    "os-browserify": "0.3.0",
    "postcss-flexbugs-fixes": "5.0.2",
    "postcss-loader": "6.2.1",
    "postcss-normalize": "10.0.1",
    "postcss-preset-env": "7.0.1",
    "prompts": "2.4.2",
    "ramda": "0.28.0",
    "react": "18.2.0",
    "react-app-polyfill": "3.0.0",
    "react-bootstrap": "2.7.0",
    "react-dev-utils": "12.0.0",
    "react-dom": "18.2.0",
    "react-hook-form": "7.43.0",
    "react-leaflet": "4.2.0",
    "react-markdown": "8.0.5",
    "react-redux": "8.0.5",
    "react-refresh": "^0.14.0",
    "react-router-dom": "^5.0.0",
    "react-text-mask": "^5.5.0",
    "react-transition-group": "4.4.5",
    "redux-saga": "1.2.2",
    "resolve": "1.20.0",
    "resolve-url-loader": "4.0.0",
    "sass-loader": "13.2.0",
    "semver": "7.3.5",
    "source-map-loader": "3.0.0",
    "stream-browserify": "3.0.0",
    "stream-http": "3.2.0",
    "style-loader": "3.3.1",
    "styled-components": "^6.1.8",
    "terser-webpack-plugin": "5.2.5",
    "text-mask-addons": "^3.8.0",
    "url": "0.11.0",
    "util": "0.12.4",
    "wagmi": "^0.11.4",
    "webpack": "5.64.4",
    "webpack-dev-server": "4.6.0",
    "webpack-manifest-plugin": "4.0.2",
    "workbox-webpack-plugin": "6.4.1",
    "yup": "0.32.11"
  },
  "config": {
    "bucket": "sos.xyzteknoloji.com",
    "distribution": "E3DUWGXJEWO7XW"
  },
  "scripts": {
    "start": "NODE_ENV=dev FAST_REFRESH=false node scripts/start.js",
    "build": "node scripts/build.js",
    "predeploy": "npm run build",
    "deploy": "aws s3 sync ./build/ s3://sos.xyzteknoloji.com --delete && aws cloudfront create-invalidation --distribution-id E3DUWGXJEWO7XW --paths \"/*\"",
    "test": "node scripts/test.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app/jest",
      "eslint:recommended",
      "plugin:jest/recommended"
    ],
    "plugins": [
      "jest"
    ],
    "rules": {
      "linebreak-style": 0,
      "indent": [
        2,
        "space"
      ],
      "react/jsx-uses-react": "error"
    },
    "env": {
      "NODE_ENV": "development",
      "node": true,
      "browser": true,
      "jest/globals": true
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "roots": [
      "<rootDir>/src"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "setupFiles": [
      "react-app-polyfill/jsdom"
    ],
    "setupFilesAfterEnv": [],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,jsx,ts,tsx}",
      "<rootDir>/src/**/*.{spec,test}.{js,jsx,ts,tsx}"
    ],
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.(js|jsx|mjs|cjs|ts|tsx)$": "<rootDir>/config/jest/babelTransform.js",
      "^.+\\.css$": "<rootDir>/config/jest/cssTransform.js",
      "^(?!.*\\.(js|jsx|mjs|cjs|ts|tsx|css|json)$)": "<rootDir>/config/jest/fileTransform.js"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.(js|jsx|mjs|cjs|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ],
    "modulePaths": [],
    "moduleNameMapper": {
      "^react-native$": "react-native-web",
      "^.+\\.module\\.(css|sass|scss)$": "identity-obj-proxy"
    },
    "moduleFileExtensions": [
      "web.js",
      "js",
      "web.ts",
      "ts",
      "web.tsx",
      "tsx",
      "json",
      "web.jsx",
      "jsx",
      "node"
    ],
    "watchPlugins": [
      "jest-watch-typeahead/filename",
      "jest-watch-typeahead/testname"
    ],
    "resetMocks": true
  },
  "babel": {
    "presets": [
      "react-app"
    ]
  },
  "browser": {
    "os": false,
    "https": false,
    "http": false,
    "stream": false,
    "util": "./node_modules/util",
    "url": "./node_modules/url",
    "assert": false,
    "crypto": false
  },
  "devDependencies": {
    "@types/react-router-dom": "^5.3.3",
    "autoprefixer": "^10.4.18",
    "buffer": "^6.0.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1"
  }
}
